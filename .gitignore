# Rust
/target/

# JS / Bun
node_modules/
dist/
test-results/

# Tauri
apps/jar/src-tauri/gen/
apps/jar/src-tauri/target/

# Editors / OS
.DS_Store
.vscode/
.idea/
*.swp

# Claude Code agent worktrees (`.claude/worktrees/`) — nested git worktrees
# whose paths escape this file's own anchored patterns above (e.g.
# `apps/jar/src-tauri/gen/` only matches at the repo root), so a stray one
# left checked out here shows up as noise in `prettier --check .`/`git
# status` otherwise. Nothing under `.claude/` is meant to be tracked.
.claude/

# App data (local dev jar snapshots)
*.jar-snapshot

# Machine-specific remote-dev config (LAN IP of whichever desktop is
# running `dev:lan`) — copy tauri.conf.remote.json.example and fill it in.
apps/jar/src-tauri/tauri.conf.remote.json

# Cross-compiled Windows dev binary bundle (jar.exe + WebView2Loader.dll),
# built locally via `cargo xwin` and copied to a Windows machine by hand —
# not a tracked build output.
/dist-windows-remote-dev/
