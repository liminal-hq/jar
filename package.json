{
  "name": "jar",
  "private": true,
  "version": "0.3.0",
  "workspaces": [
    "apps/*",
    "plugins/*/guest-js"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/jar dev",
    "dev:lan": "bun run --cwd apps/jar dev:lan",
    "tauri": "bun run --cwd apps/jar tauri",
    "tauri:dev": "bun run --cwd apps/jar tauri:dev",
    "tauri:dev:remote": "bun run --cwd apps/jar tauri:dev:remote",
    "build": "bun run --cwd apps/jar build",
    "test:js": "vitest run",
    "test:js:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "test:rust": "cargo nextest run --workspace",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bun run format:check && bun run test:js && bun run build && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && bun run test:rust",
    "release:version:check": "bash ./scripts/check-release-versions.sh"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "three": "^0.169.0"
  }
}
