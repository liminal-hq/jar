{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jar",
  "version": "0.3.0",
  "identifier": "ca.liminalhq.jar",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "tank",
        "title": "Jar",
        "width": 840,
        "height": 640,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Liminal HQ",
    "homepage": "https://github.com/liminal-hq/jar",
    "copyright": "Copyright 2026 Liminal HQ, Scott Morris",
    "license": "Apache-2.0 OR MIT",
    "category": "Entertainment",
    "shortDescription": "A tiny floating desktop aquarium",
    "longDescription": "A floating desktop aquarium with a few fish who live, sleep, breed, age and pass on in real time. A quiet little world to check in on, something calm to glance at rather than a game to win.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
