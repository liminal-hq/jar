{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to every Jar window — the tank plus the critter card, family tree and setup windows created at runtime (SPEC.md §2).",
  "windows": [
    "tank",
    "critter-card",
    "family-tree",
    "setup",
    "dev-settings",
    "tank-monitor",
    "fish-eye"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-theme",
    "core:window:allow-set-focus",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-maximizable",
    "core:window:allow-is-minimizable",
    "core:window:allow-is-resizable",
    "core:window:allow-set-size",
    "core:window:allow-scale-factor",
    "core:webview:allow-create-webview-window",
    "jar:default",
    "window-state:default",
    "os:default",
    "mcp-bridge:default",
    "clipboard-manager:allow-write-image",
    "log:default"
  ]
}
